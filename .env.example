# MongoDB
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority"

# Razorpay (keep the secret server-side)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"

# Brevo SMTP (free tier; use the SMTP relay credentials from Brevo)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your_brevo_login_email"
SMTP_PASSWORD="your_brevo_smtp_key"

# Sender and organization recipient. Verify this sender in Brevo first.
SMTP_FROM_EMAIL="notifications@your-verified-domain.com"
COMPANY_EMAIL="admin@your-verified-domain.com"

# Meta WhatsApp Cloud API (optional; requires an approved utility template)
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_access_token"
WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_meta_business_account_id"
WHATSAPP_TEMPLATE_NAME="payment_confirmation"
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
COMPANY_WHATSAPP_PHONE="919876543210"
